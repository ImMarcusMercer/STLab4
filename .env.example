HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info
# db:setup generates a local password and writes an ignored .env.
DATABASE_URL=postgresql://bcis_local:replace-with-local-password@127.0.0.1:55432/bcis
BCIS_API_URL=http://127.0.0.1:3100
BOOTSTRAP_ADMIN_USERNAME=owner
# db:seed generates BOOTSTRAP_ADMIN_PASSWORD in ignored .env when absent.
